#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <165>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1     &kp N2          &kp N3       &kp N4            &kp N5  &tog 1                                                          &mo 3        &kp N6  &kp N7             &kp N8       &kp N9          &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W           &kp E        &kp R             &kp T   &none                                                           &none        &kp Y   &kp U              &kp I        &kp O           &kp P     &kp BSLH
&kp ESC    &kp A      &hm LEFT_ALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G   &none            &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none        &kp H   &hm RIGHT_SHIFT J  &hm LCTRL K  &hm LEFT_ALT L  &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X           &kp C        &kp V             &kp B                               &kp HOME      &kp PG_UP                          &kp N   &kp M              &kp COMMA    &kp DOT         &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS        &kp LEFT     &kp RIGHT                 &lt 2 BACKSPACE  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &lt 1 SPACE          &kp UP             &kp DOWN     &kp LBKT        &kp RBKT  &mo 2
            >;
        };

        layer1 {
            bindings = <
&kp EQUAL  &kp NUMBER_1  &kp N2    &kp N3                &kp N4                 &kp N5     &trans                                                          &mo 3   &kp N6    &kp N7    &kp N8        &kp N9     &kp N0   &kp MINUS
&kp F1     &kp F2        &kp F3    &kp F4                &kp F5                 &kp F6     &none                                                           &none   &kp F7    &kp F8    &kp F9        &kp F10    &kp F11  &kp F12
&kp ESC    &none         &none     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &none            &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none   &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp END  &kp BACKSLASH
&kp LSHFT  &none         &none     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none                                  &kp HOME      &kp PG_UP                     &none     &kp HOME  &none         &none      &none    &kp RSHFT
&none      &kp GRAVE     &kp CAPS  &kp LEFT              &kp RIGHT                         &lt 3 BACKSPACE  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &trans            &kp UP    &kp DOWN      &none      &none    &none
            >;
        };

        layer2 {
            bindings = <
&kp F1  &kp F2           &kp F3           &kp F4           &kp F5           &kp F6     &none                                       &none        &kp F7     &kp F8          &kp F9       &kp F10         &kp F11          &kp F12
&trans  &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans     &none                                       &none        &kp SLASH  &kp UNDERSCORE  &kp KP_PLUS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp TILDE
&trans  &kp SLASH        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp EQUAL  &none   &trans  &trans      &trans  &trans  &none        &kp SLASH  &kp UNDERSCORE  &kp KP_PLUS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp GRAVE
&trans  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans                     &trans      &trans                       &trans     &kp MINUS       &trans       &trans          &trans           &trans
&trans  &trans           &trans           &trans           &trans                      &trans  &trans  &trans      &trans  &trans  &lt 3 SPACE             &trans          &trans       &trans          &trans           &trans
            >;
        };

        symbols {
            bindings = <
&none  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none      &none          &none         &none                 &none                  &none
&none  &none            &none         &none         &none         &none         &bootloader                                            &bootloader             &none      &none          &none         &none                 &none                  &none
&none  &kp EXCLAMATION  &kp AT_SIGN   &kp POUND     &kp DOLLAR    &kp PERCENT   &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&none  &none            &none         &none         &macro_ver    &none                             &none      &none                                           &none      &none          &none         &none                 &none                  &none
&none  &none            &none         &none         &none                       &trans       &none  &none      &none       &bl BL_TOG  &trans                             &bl BL_INC     &bl BL_DEC    &none                 &none                  &none
            >;
        };

        layer4 {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N2  &kp N4  &kp N5  &kp NON_US_BACKSLASH                                                      &trans     &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E   &kp R   &kp T   &trans                                                                    &trans     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D   &kp F   &kp G   &trans                &kp LCTRL   &kp LALT      &kp RGUI       &kp RCTRL  &trans     &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z      &kp X     &kp C   &kp V   &kp B                                     &kp HOME      &kp PAGE_UP                          &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&trans     &kp GRAVE  &kp CAPS  &trans  &trans          &kp BSPC              &kp DELETE  &kp END       &kp PAGE_DOWN  &kp ENTER  &kp SPACE          &trans  &trans     &kp LBKT  &kp RBKT  &trans
            >;
        };
    };
};
